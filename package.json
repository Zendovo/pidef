{
  "name": "pidef",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:qpdf": "node scripts/build-qpdf-from-source.mjs",
    "prepare:engines": "node scripts/prepare-bundled-engines.mjs",
    "verify:engines": "node scripts/verify-bundled-engines.mjs",
    "package:app": "npm run verify:engines && npm run tauri build -- --bundles app",
    "package:release": "npm run verify:engines && npm run tauri build",
    "tauri": "tauri",
    "test": "vitest run",
    "build:wasm": "wasm-pack build crates/pdf_tool_core_wasm --target web --release --out-dir ../../src/generated/pdf_tool_core_wasm",
    "e2e:web": "node scripts/e2e-web.mjs"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "wasm-pack": "^0.15.0"
  }
}
