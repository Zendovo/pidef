{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pidef",
  "version": "0.1.0",
  "identifier": "dev.pidef",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pidef",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/bin"],
    "icon": []
  }
}
